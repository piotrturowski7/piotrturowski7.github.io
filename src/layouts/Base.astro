---
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import fontLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { seo, company } from '../content/site';
import { CONTACT_EMAIL } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
  headerCta?: boolean;
  jsonLd?: boolean;
}
const {
  title = seo.title,
  description = seo.description,
  noindex = false,
  home = false,
  headerCta = true,
  jsonLd = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.everhome.com.pl');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.png', site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.brand,
  legalName: company.legalName,
  description: seo.description,
  url: site.href,
  logo: new URL('/apple-touch-icon.png', site).href,
  image: ogImage,
  telephone: company.phoneHref,
  ...(CONTACT_EMAIL ? { email: CONTACT_EMAIL } : {}),
  taxID: company.nip,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street.replace(/^ul\.\s*/, 'ul. '),
    postalCode: company.postalCode,
    addressLocality: company.city,
    addressCountry: company.country,
  },
  areaServed: { '@type': 'Country', name: 'Polska' },
  knowsAbout: ['Meta Ads', 'Facebook Ads', 'Instagram Ads', 'Domy modułowe'],
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />

    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="everhome" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class="min-h-dvh">
    <a
      href="#tresc"
      class="sr-only z-[60] bg-ink px-4 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >Przejdź do treści</a>
    <Header home={home} showCta={headerCta} />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
    <CookieBanner />
    <script>
      import { captureAttribution } from '../scripts/attribution';
      captureAttribution();

      // Subtelne pojawianie się sekcji
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { problem } from '../../content/site';
---
<Section index="02" label={problem.label} title={problem.title}>
  <ul class="mt-12 grid border-t border-line sm:grid-cols-2 md:mt-16">
    {problem.items.map((item, i) => (
      <li class:list={['border-b border-line py-8 sm:px-0 md:py-10', i % 2 === 0 ? 'sm:pr-8 md:pr-12' : 'sm:border-l sm:pl-8 md:pl-12']}>
        <Icon name={item.icon} size={28} class="text-accent" />
        <h3 class="h3 mt-6">{item.title}</h3>
        <p class="mt-3 max-w-md text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
</Section>

---
import Section from '../Section.astro';
import { whyMeta } from '../../content/site';
---
<Section index="03" label={whyMeta.label} title={whyMeta.title}>
  <p class="mt-8 max-w-3xl text-xl leading-relaxed md:text-2xl md:leading-relaxed">{whyMeta.intro}</p>
  <ul class="mt-14 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-8">
    {whyMeta.items.map((item) => (
      <li class="border-t border-ink pt-6">
        <h3 class="h3">{item.title}</h3>
        <p class="mt-3 text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
</Section>

---
import CtaButton from '../CtaButton.astro';
import VideoEmbed from '../VideoEmbed.astro';
import Icon from '../Icon.astro';
import { hero, caseStudy } from '../../content/site';
---
<section id="hero" aria-labelledby="hero-tytul" class="pt-12 pb-16 md:pt-20 md:pb-24">
  <div class="page">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-tytul" class="h1 mt-6 max-w-[17ch] md:mt-8">{hero.title}</h1>

    <div class="mt-10 grid gap-12 md:mt-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6">
        <p class="max-w-xl text-lg leading-relaxed text-muted md:text-xl">{hero.lead}</p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
          <CtaButton class="w-full sm:w-auto" />
          <a href={`#${caseStudy.id}`} class="group inline-flex min-h-11 items-center justify-center gap-2 font-semibold sm:justify-start">
            <span class="link-underline">{hero.secondaryCta}</span>
            <Icon name="arrow-down" size={18} class="transition-transform group-hover:translate-y-0.5" />
          </a>
        </div>
      </div>
      <div class="lg:col-span-6">
        <VideoEmbed url={hero.videoUrl} title={hero.videoTitle} placeholder={hero.videoPlaceholder} />
      </div>
    </div>

    <div class="mt-14 md:mt-20">
      <dl class="grid grid-cols-3 border-y border-line">
        {hero.stats.map((s, i) => (
          <div class:list={['flex flex-col py-6 md:py-8', i > 0 && 'border-l border-line pl-4 md:pl-8']}>
            <dt class="order-2 mt-2 text-sm leading-snug text-muted md:text-base">{s.label}</dt>
            <dd class="order-1">
              <span class="block h-[3px] w-7 bg-accent" aria-hidden="true"></span>
              <span class="mt-4 block text-[1.75rem] leading-none font-semibold tracking-[-0.03em] tabular-nums sm:text-4xl md:text-6xl">{s.value}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-sm text-muted">{hero.statsNote}</p>
    </div>
  </div>
</section>

---
import Section from '../Section.astro';
import CtaButton from '../CtaButton.astro';
import { process } from '../../content/site';
---
<Section index="04" label={process.label} title={process.title}>
  <ol class="mt-12 grid gap-0 md:mt-16 md:grid-cols-2 xl:grid-cols-4">
    {process.steps.map((step, i) => (
      <li class:list={[
        'relative border-t border-line py-8 md:py-10',
        'md:pr-8',
        i % 2 === 1 && 'md:border-l md:pl-8 xl:border-l',
        i > 0 && 'xl:border-l xl:pl-8',
      ]}>
        <span class="flex h-11 w-11 items-center justify-center bg-accent text-lg font-semibold text-ink tabular-nums" aria-hidden="true">{i + 1}</span>
        <h3 class="h3 mt-6"><span class="sr-only">Krok {i + 1}: </span>{step.title}</h3>
        <p class="mt-3 text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="mt-6 border-t border-line pt-10">
    <CtaButton class="w-full sm:w-auto" />
  </div>
</Section>

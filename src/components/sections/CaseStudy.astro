---
import Section from '../Section.astro';
import GalleryItem from '../GalleryItem.astro';
import Lightbox from '../Lightbox.astro';
import { caseStudy } from '../../content/site';
---
<Section id={caseStudy.id} index="05" label={caseStudy.label} title={caseStudy.title}>
  <p class="mt-6 text-muted">{caseStudy.intro}</p>

  <dl class="mt-12 grid grid-cols-2 gap-px border-y border-line bg-line md:mt-14 lg:grid-cols-5">
    {caseStudy.stats.map((s, i) => (
      <div class:list={[
        'flex flex-col bg-paper py-6 pr-4 md:py-8',
        i % 2 === 1 && 'pl-5',
        i > 0 && 'lg:pl-6',
        i === caseStudy.stats.length - 1 && 'col-span-2 lg:col-span-1',
      ]}>
        <dt class="text-sm text-muted">{s.label}</dt>
        <dd class="mt-2 text-3xl font-semibold whitespace-nowrap tracking-[-0.03em] tabular-nums xl:text-4xl">{s.value}</dd>
      </div>
    ))}
  </dl>

  <p class="mt-14 max-w-4xl text-[2rem] leading-[1.15] font-semibold tracking-[-0.03em] md:mt-20 md:text-6xl md:leading-[1.08]">
    <span class="underline decoration-accent decoration-[0.12em] underline-offset-[0.14em]">{caseStudy.highlight.value}</span>
    {' '}{caseStudy.highlight.text}
  </p>

  <div class="mt-14 grid gap-4 border-t border-line pt-8 md:mt-20 md:grid-cols-9 md:gap-10">
    <h3 class="h3 md:col-span-3">{caseStudy.whatWeDidTitle}</h3>
    <p class="max-w-2xl text-lg leading-relaxed text-muted md:col-span-6">{caseStudy.whatWeDid}</p>
  </div>

  <div class="mt-14 md:mt-16">
    <h3 class="text-sm font-semibold tracking-[0.08em] uppercase">{caseStudy.galleryResultsTitle}</h3>
    <ul class="mt-5 grid gap-4 md:grid-cols-2 md:gap-6">
      {caseStudy.results.map((r) => (
        <li><GalleryItem file={r.file} alt={r.alt} ratio="16 / 10" sizes="(min-width: 1024px) 440px, (min-width: 768px) 45vw, 100vw" placeholder="Zrzut z Menedżera reklam" /></li>
      ))}
    </ul>
  </div>

  <div class="mt-12">
    <h3 class="text-sm font-semibold tracking-[0.08em] uppercase">{caseStudy.galleryAdsTitle}</h3>
    <ul class="mt-5 grid grid-cols-3 gap-2 sm:gap-4 md:gap-6">
      {caseStudy.ads.map((r) => (
        <li><GalleryItem file={r.file} alt={r.alt} ratio="4 / 5" sizes="(min-width: 1024px) 290px, 33vw" placeholder="Przykładowa reklama" /></li>
      ))}
    </ul>
  </div>

  <p class="mt-8 text-sm text-muted">{caseStudy.note}</p>
  <Lightbox />
</Section>

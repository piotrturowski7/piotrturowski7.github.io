---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import Todo from '../Todo.astro';
import { faq } from '../../content/site';
---
<Section index="09" label={faq.label} title={faq.title}>
  <div class="mt-12 border-t border-line md:mt-16">
    {faq.items.map((item) => (
      <details class="faq group border-b border-line">
        <summary class="flex cursor-pointer items-start justify-between gap-6 py-6 text-lg font-semibold md:py-7 md:text-xl">
          <h3>{item.q}</h3>
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center border border-line transition-transform duration-300 group-open:rotate-45 group-open:border-accent group-open:bg-accent motion-reduce:transition-none" aria-hidden="true">
            <Icon name="plus" size={18} />
          </span>
        </summary>
        <p class="max-w-2xl pb-7 text-muted"><Todo text={item.a} /></p>
      </details>
    ))}
  </div>
</Section>

---
/** Miniatura w galerii: otwiera lightbox. Jeśli pliku brakuje – placeholder o właściwych proporcjach. */
import { Picture, getImage as optimize } from 'astro:assets';
import MediaPlaceholder from './MediaPlaceholder.astro';
import Icon from './Icon.astro';
import { getImage } from '../lib/assets';
import { caseStudy } from '../content/site';
interface Props { file: string; alt: string; ratio: string; sizes: string; placeholder: string }
const { file, alt, ratio, sizes, placeholder } = Astro.props;
const img = getImage(file);
const full = img ? await optimize({ src: img, width: Math.min(img.width, 1800), format: 'webp', quality: 82 }) : undefined;
---
{
  img && full ? (
    <a
      href={full.src}
      data-lightbox
      data-alt={alt}
      class="group relative block overflow-hidden border border-line bg-soft"
      style={`aspect-ratio: ${ratio}`}
    >
      <Picture
        src={img}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[400, 700, 1000].filter((w) => w <= img.width)}
        sizes={sizes}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
      />
      <span class="absolute right-3 bottom-3 flex h-10 w-10 items-center justify-center bg-paper text-ink" aria-hidden="true">
        <Icon name="expand" size={18} />
      </span>
      <span class="sr-only">{caseStudy.zoomLabel}</span>
    </a>
  ) : (
    <MediaPlaceholder ratio={ratio} label={placeholder} file={`materialy/${file}.${file.startsWith('reklama') ? 'jpg' : 'png'}`} />
  )
}

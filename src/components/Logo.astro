---
import { Image } from 'astro:assets';
import { getImage, getLogoSvg } from '../lib/assets';
interface Props { class?: string; alt?: string }
const { class: cls = 'h-7', alt = 'everhome' } = Astro.props;
const svg = getLogoSvg()
  ?.replace(/<\?xml[^>]*>/, '')
  .replace(/<svg\b/, `<svg role="img" aria-label="${alt}"`);
const png = svg ? undefined : getImage('logo');
---
{
  svg ? (
    <span class:list={['logo-svg inline-flex', cls]} set:html={svg} />
  ) : png ? (
    <Image src={png} alt={alt} class:list={['w-auto', cls]} height={96} loading="eager" />
  ) : (
    /* Zastępczy znak słowny – zniknie po dodaniu materialy/logo.svg lub logo.png */
    <span class:list={['inline-flex items-center gap-1.5 text-[1.375rem] leading-none font-bold tracking-[-0.04em]', cls]} aria-label={alt} role="img">
      <span aria-hidden="true">everhome</span>
      <span aria-hidden="true" class="mt-auto mb-[0.2em] h-[0.3em] w-[0.3em] bg-accent" />
    </span>
  )
}
<style>
  .logo-svg :global(svg) { height: 100%; width: auto; display: block; }
</style>
